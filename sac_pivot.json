{
    "name": "SacPivotWidget",
    "description": "Satir/sutun/filtre/measure disaridan verilen pivot tablo",
    "newInstancePrefix": "SacPivot",
    "eula": "",
    "vendor": "Custom",
    "license": "",
    "id": "com.custom.sacpivot",
    "version": "1.13.2",
    "icon": "",
    "webcomponents": [
        {
            "kind": "main",
            "tag": "custom-sac-pivot",
            "url": "https://bizimniyan.github.io/sac-widgets/sac_pivot.js?v=1132",
            "integrity": "",
            "ignoreIntegrity": true
        },
        {
            "kind": "builder",
            "tag": "custom-sac-pivot-builder",
            "url": "https://bizimniyan.github.io/sac-widgets/sac_pivot_builder.js?v=1132",
            "integrity": "",
            "ignoreIntegrity": true
        }
    ],
    "properties": {
        "width": { "type": "integer", "default": 1000 },
        "height": { "type": "integer", "default": 500 },
        "providerId": { "type": "string", "default": "Cgo60cs80hp2214495dtio17t3c" },
        "rowDims": { "type": "string", "default": "ZMALZEME:Malzeme, ZMALZEME.MALZ_GRUP1:Grup 1, ZMALZEME.MALZ_GRUP2:Grup 2, ZTEDARIKCI:Tedarikçi, ZCURRENCY:Para Birimi" },
        "colDims": { "type": "string", "default": "ZPARAMETRE:Parametre, Date" },
        "filters": { "type": "string", "default": "ZPARAMETRE=USM0016,USM0017,USM0018,USM0003_T,USM0008" },
        "measures": { "type": "string", "default": "ZMIKTAR:Miktar,ZORAN:Oran" },
        "measureSelect": { "type": "string", "default": "x" },
        "freezeCols": { "type": "string", "default": "5" }
    },
    "methods": {
        "setVersion": {
            "description": "Versiyonu verir ve veriyi yukler (zorunlu; verilmeden veri cekilmez)",
            "parameters": [
                { "name": "version", "type": "string", "description": "Versiyon ID, orn. public.2027BUD_01" }
            ]
        },
        "setCompanyCode": {
            "description": "Sirket kodunu verir ve veriyi yukler (zorunlu; bos = hepsi, virgulle coklu)",
            "parameters": [
                { "name": "companyCode", "type": "string", "description": "Sirket kodu, orn. 1100" }
            ]
        },
        "setFilter": {
            "description": "Sabit filtreyi degistirir ve veriyi yeniden yukler; bos deger = filtreyi kaldir",
            "parameters": [
                { "name": "dimension", "type": "string", "description": "Boyut ID, orn. Version, ZSIRKET_KODU" },
                { "name": "values", "type": "string", "description": "Degerler virgulle, orn. 1100,1200" }
            ]
        },
        "setMeasureSelection": {
            "description": "Measure secimli acikken gosterilecek tutar: ZTUTAR, ZTUTAR_EUR, ZTUTAR_USD, ZTUTAR_TRY",
            "parameters": [
                { "name": "measure", "type": "string", "description": "orn. ZTUTAR_EUR" }
            ]
        },
        "getMeasureSelection": {
            "description": "Secili tutar measure'i",
            "parameters": [],
            "returnType": "string"
        },
        "getFilter": {
            "description": "Boyutun gecerli sabit filtre degerleri (virgulle)",
            "parameters": [
                { "name": "dimension", "type": "string", "description": "Boyut ID" }
            ],
            "returnType": "string"
        },
        "setSelection": {
            "description": "Satir boyutu secim kutusu: 11*, 11000001, 11000000-11009999, (boş), !kod = haric; birden fazlasi ; ile, bos = tumu",
            "parameters": [
                { "name": "dimension", "type": "string", "description": "Satir boyutu ID" },
                { "name": "values", "type": "string", "description": "Secim metni" }
            ]
        },
        "getSelection": {
            "description": "Satir boyutunun gecerli secimi",
            "parameters": [
                { "name": "dimension", "type": "string", "description": "Satir boyutu ID" }
            ],
            "returnType": "string"
        },
        "exportExcel": {
            "description": "Secime uyan satirlari Excel'e aktarir",
            "parameters": []
        },
        "refresh": {
            "description": "Veriyi yeniden yukler",
            "parameters": []
        }
    },
    "events": {}
}
