{
    "name": "MaliPivotWidget",
    "description": "Malitablo pivotu: ara toplamli satirlar, donem toplami yok",
    "newInstancePrefix": "MaliPivot",
    "eula": "",
    "vendor": "Custom",
    "license": "",
    "id": "com.custom.malipivot",
    "version": "1.1.9",
    "icon": "",
    "webcomponents": [
        {
            "kind": "main",
            "tag": "custom-mali-pivot",
            "url": "https://bizimniyan.github.io/sac-widgets/mali_pivot.js?v=110",
            "integrity": "",
            "ignoreIntegrity": true
        },
        {
            "kind": "builder",
            "tag": "custom-mali-pivot-builder",
            "url": "https://bizimniyan.github.io/sac-widgets/mali_pivot_builder.js?v=110",
            "integrity": "",
            "ignoreIntegrity": true
        }
    ],
    "properties": {
        "width": {
            "type": "integer",
            "default": 1000
        },
        "height": {
            "type": "integer",
            "default": 500
        },
        "providerId": {
            "type": "string",
            "default": "Cg9hh4g6np3fl2l5al8cu22d5d"
        },
        "rowDims": {
            "type": "string",
            "default": "ZKAYNAKMODEL:Kaynak Model, ZHESAPLAMA:Hesaplama Yöntemi, ZMAPPING:Mapping, ZCURRENCY:Para Birimi, ZHESAP:Hesap"
        },
        "colDims": {
            "type": "string",
            "default": "ZPARAMETRE:Parametre, Date"
        },
        "filters": {
            "type": "string",
            "default": ""
        },
        "measures": {
            "type": "string",
            "default": ""
        },
        "measureSelect": {
            "type": "string",
            "default": "x"
        },
        "freezeCols": {
            "type": "string",
            "default": "6"
        },
        "subtotalDims": {
            "type": "string",
            "default": "3"
        }
    },
    "methods": {
        "setVersion": {
            "description": "Versiyonu verir ve veriyi yukler (zorunlu; verilmeden veri cekilmez)",
            "parameters": [
                {
                    "name": "version",
                    "type": "string",
                    "description": "Versiyon ID, orn. public.2027BUD_01"
                }
            ]
        },
        "setCompanyCode": {
            "description": "Sirket kodunu verir ve veriyi yukler (zorunlu; bos = hepsi, virgulle coklu)",
            "parameters": [
                {
                    "name": "companyCode",
                    "type": "string",
                    "description": "Sirket kodu, orn. 1100"
                }
            ]
        },
        "setFilter": {
            "description": "Sabit filtreyi degistirir ve veriyi yeniden yukler; bos deger = filtreyi kaldir",
            "parameters": [
                {
                    "name": "dimension",
                    "type": "string",
                    "description": "Boyut ID, orn. Version, ZSIRKET_KODU"
                },
                {
                    "name": "values",
                    "type": "string",
                    "description": "Degerler virgulle, orn. 1100,1200"
                }
            ]
        },
        "setMeasureSelection": {
            "description": "Measure secimli acikken gosterilecek tutar: ZTUTAR, ZTUTAR_EUR, ZTUTAR_USD, ZTUTAR_TRY",
            "parameters": [
                {
                    "name": "measure",
                    "type": "string",
                    "description": "orn. ZTUTAR_EUR"
                }
            ]
        },
        "getMeasureSelection": {
            "description": "Secili tutar measure'i",
            "parameters": [],
            "returnType": "string"
        },
        "getFilter": {
            "description": "Boyutun gecerli sabit filtre degerleri (virgulle)",
            "parameters": [
                {
                    "name": "dimension",
                    "type": "string",
                    "description": "Boyut ID"
                }
            ],
            "returnType": "string"
        },
        "setSelection": {
            "description": "Satir boyutu secim kutusu: 11*, 11000001, 11000000-11009999, (boş), !kod = haric; birden fazlasi ; ile, bos = tumu",
            "parameters": [
                {
                    "name": "dimension",
                    "type": "string",
                    "description": "Satir boyutu ID"
                },
                {
                    "name": "values",
                    "type": "string",
                    "description": "Secim metni"
                }
            ]
        },
        "getSelection": {
            "description": "Satir boyutunun gecerli secimi",
            "parameters": [
                {
                    "name": "dimension",
                    "type": "string",
                    "description": "Satir boyutu ID"
                }
            ],
            "returnType": "string"
        },
        "exportExcel": {
            "description": "Secime uyan satirlari Excel'e aktarir",
            "parameters": []
        },
        "refresh": {
            "description": "Veriyi yeniden yukler",
            "parameters": []
        }
    },
    "events": {}
}