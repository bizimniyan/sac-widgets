{
    "name": "GiderPivotWidget",
    "description": "Gider pivot tablosu (masraf yeri, masraf cesidi, PYP, parametre, para birimi)",
    "newInstancePrefix": "GiderPivot",
    "eula": "",
    "vendor": "Custom",
    "license": "",
    "id": "com.custom.giderpivot",
    "version": "1.2.0",
    "icon": "",
    "webcomponents": [
        {
            "kind": "main",
            "tag": "custom-gider-pivot",
            "url": "https://bizimniyan.github.io/sac-widgets/gider_pivot.js?v=120",
            "integrity": "",
            "ignoreIntegrity": true
        },
        {
            "kind": "builder",
            "tag": "custom-gider-pivot-builder",
            "url": "https://bizimniyan.github.io/sac-widgets/gider_pivot_builder.js?v=120",
            "integrity": "",
            "ignoreIntegrity": true
        }
    ],
    "properties": {
        "width": { "type": "integer", "default": 1000 },
        "height": { "type": "integer", "default": 500 },
        "providerId": { "type": "string", "default": "C206aen5clh2sh7ml7jvoco615" },
        "rowDims": { "type": "string", "default": "ZMASRAF_YERI:Masraf Yeri, ZMASRAF_CESIDI:Masraf Çeşidi, ZMASRAF_CESIDI.UST_GRUP:Üst Grup, ZMASRAF_CESIDI.ZBUTCE_KODU:Bütçe Kodu, ZMASRAF_CESIDI.ZBUTCE_KODU_TANIM:Bütçe Kodu Tanımı, ZMASRAF_CESIDI.ZAKTIVITE:3lüKod, ZPYP_KODU:PYP Kodu, ZCURRENCY:Para Birimi" },
        "colDims": { "type": "string", "default": "ZPARAMETRE:Parametre, Date" },
        "filters": { "type": "string", "default": "ZPARAMETRE=GDR0001,GDR0002,GDR0003,GDR0004,GDR0005; ZDATA_SOURCE=INP,CALC,TRNSFR" },
        "measures": { "type": "string", "default": "" },
        "measureSelect": { "type": "string", "default": "x" },
        "freezeCols": { "type": "string", "default": "4" }
    },
    "methods": {
        "setVersion": {
            "description": "Versiyonu verir ve veriyi yukler (zorunlu; verilmeden veri cekilmez)",
            "parameters": [
                { "name": "version", "type": "string", "description": "Versiyon ID, orn. public.2027BUD_01" }
            ]
        },
        "setCompanyCode": {
            "description": "Sirket kodunu verir ve veriyi yukler (zorunlu; bos = hepsi, virgulle coklu)",
            "parameters": [
                { "name": "companyCode", "type": "string", "description": "Sirket kodu, orn. 1100" }
            ]
        },
        "setFilter": {
            "description": "Sabit filtreyi degistirir ve veriyi yeniden yukler; bos deger = filtreyi kaldir",
            "parameters": [
                { "name": "dimension", "type": "string", "description": "Boyut ID, orn. Version, ZSIRKET_KODU" },
                { "name": "values", "type": "string", "description": "Degerler virgulle, orn. 1100,1200" }
            ]
        },
        "setMeasureSelection": {
            "description": "Measure secimli acikken gosterilecek tutar: ZTUTAR, ZTUTAR_TRY, ZTUTAR_EUR, ZTUTAR_USD",
            "parameters": [
                { "name": "measure", "type": "string", "description": "orn. ZTUTAR_EUR" }
            ]
        },
        "getMeasureSelection": {
            "description": "Secili tutar measure'i",
            "parameters": [],
            "returnType": "string"
        },
        "getFilter": {
            "description": "Boyutun gecerli sabit filtre degerleri (virgulle)",
            "parameters": [
                { "name": "dimension", "type": "string", "description": "Boyut ID" }
            ],
            "returnType": "string"
        },
        "setSelection": {
            "description": "Satir boyutu secim kutusu: 77*, 7701400002, 7700000000-7709999999, (boş), !kod = haric; birden fazlasi ; ile, bos = tumu",
            "parameters": [
                { "name": "dimension", "type": "string", "description": "Satir boyutu ID" },
                { "name": "values", "type": "string", "description": "Secim metni" }
            ]
        },
        "getSelection": {
            "description": "Satir boyutunun gecerli secimi",
            "parameters": [
                { "name": "dimension", "type": "string", "description": "Satir boyutu ID" }
            ],
            "returnType": "string"
        },
        "exportExcel": {
            "description": "Secime uyan satirlari Excel'e aktarir",
            "parameters": []
        },
        "refresh": {
            "description": "Veriyi yeniden yukler",
            "parameters": []
        }
    },
    "events": {}
}
